# Copie este arquivo para .env.local e preencha com sua chave real.
# .env.local nunca é commitado (ja esta no .gitignore).

# Chave da API de IA generativa usada no fluxo de tutoria.
# Por padrao o projeto espera uma chave do Google AI Studio (Gemini), gratuita e sem cartao de credito.
# Gere a sua em https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Alternativas tambem aceitas pela API:
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Opcional. Se nao preencher, usa gemini-2.5-flash.
# GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash
